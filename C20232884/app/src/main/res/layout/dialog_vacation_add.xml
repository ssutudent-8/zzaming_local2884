<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToPadding="false"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Text.App.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="휴가 추가" />

        <EditText
            android:id="@+id/input_vacation_title"
            style="@style/Widget.App.Input"
            android:hint="제목" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_vacation_start"
                style="@style/Widget.App.Input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="시작 날짜"
                android:inputType="date" />

            <EditText
                android:id="@+id/input_vacation_end"
                style="@style/Widget.App.Input"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="종료 날짜"
                android:inputType="date" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_vacation_days"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/vacation_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="휴가 일수  1일" />

        <TextView
            android:id="@+id/btn_save_vacation"
            style="@style/Widget.App.PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="저장" />
    </LinearLayout>
</ScrollView>
