<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/vacation_item"
        style="@style/Widget.App.ListRow">

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/vacation" />

        <!-- 시작 날짜 (48dp) -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_vacation_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vacation_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="6.16" />

            <TextView
                android:id="@+id/tv_vacation_start_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vacation_text"
                android:textSize="12sp"
                tools:text="월" />
        </LinearLayout>

        <!-- 휴가 제목 (weight 1, 볼드 해제) -->
        <TextView
            android:id="@+id/tv_vacation_title"
            style="@style/Text.App.Body"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/vacation_text"
            android:textSize="14sp"
            tools:text="정기 휴가" />

        <!-- 종료 날짜 (80dp) -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_vacation_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vacation_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="6.19" />

            <TextView
                android:id="@+id/tv_vacation_end_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vacation_text"
                android:textSize="12sp"
                tools:text="목" />
        </LinearLayout>

        <!-- 휴가 기간 (60dp) -->
        <TextView
            android:id="@+id/tv_vacation_duration"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/vacation_text"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="4일" />
    </LinearLayout>
</LinearLayout>
