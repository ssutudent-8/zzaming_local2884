<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToPadding="false"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_detail_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/forest_700"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="부대 일정 상세" />

            <TextView
                android:id="@+id/btn_edit_mode"
                style="@style/Widget.App.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="수정"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_close_detail"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:contentDescription="닫기"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 1. 조회 모드 뷰 (상자 없는 깔끔한 보기) -->
        <LinearLayout
            android:id="@+id/layout_read_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_read_title"
                style="@style/Text.App.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="행정반 주간 업무 보고" />

            <TextView
                android:id="@+id/tv_read_time"
                style="@style/Text.App.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_primary"
                tools:text="일시: 2026-10-16 (19:00 ~ 20:00)" />

            <TextView
                android:id="@+id/tv_read_location"
                style="@style/Text.App.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                tools:text="장소: 본청 2층 회의실" />

            <TextView
                android:id="@+id/tv_read_memo"
                style="@style/Text.App.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                tools:text="메모: 특이사항 확인 바랍니다." />
        </LinearLayout>

        <!-- 2. 수정 모드 뷰 (상자 및 입력 폼) -->
        <LinearLayout
            android:id="@+id/layout_edit_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.App.CaptionBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일정 제목" />

            <EditText
                android:id="@+id/input_detail_title"
                style="@style/Widget.App.Input"
                android:layout_marginTop="4dp"
                android:hint="일정 제목" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.App.CaptionBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="시작 시간" />

                    <EditText
                        android:id="@+id/input_detail_start_time"
                        style="@style/Widget.App.Input"
                        android:layout_marginTop="4dp"
                        android:hint="19:00" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.App.CaptionBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="종료 시간" />

                    <EditText
                        android:id="@+id/input_detail_end_time"
                        style="@style/Widget.App.Input"
                        android:layout_marginTop="4dp"
                        android:hint="20:00" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_label_detail_location"
                style="@style/Text.App.CaptionBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="장소" />

            <EditText
                android:id="@+id/input_detail_location"
                style="@style/Widget.App.Input"
                android:layout_marginTop="4dp"
                android:hint="장소 입력" />

            <TextView
                style="@style/Text.App.CaptionBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="메모/비고" />

            <EditText
                android:id="@+id/input_detail_memo"
                style="@style/Widget.App.Input.Multiline"
                android:layout_marginTop="4dp"
                android:hint="메모 입력" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_delete_schedule"
                    style="@style/Widget.App.DangerButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="일정 삭제" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/btn_cancel_edit"
                    style="@style/ScheduleTab"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="취소" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/btn_save_schedule"
                    style="@style/Widget.App.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1.5"
                    android:text="저장" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>