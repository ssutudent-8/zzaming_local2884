<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToPadding="false"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_add_schedule_date"
            style="@style/Text.App.CaptionBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2025년 6월 16일" />

        <TextView
            style="@style/Text.App.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="일정 추가" />

        <!-- 일정 유형 선택 스피너 (권한별 분기) -->
        <TextView
            style="@style/Text.App.CaptionBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="일정 유형" />

        <Spinner
            android:id="@+id/spinner_add_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_input"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/input_schedule_title"
            style="@style/Widget.App.Input"
            android:hint="일정 제목" />

        <!-- 일반 일정용 시간 입력 그룹 -->
        <LinearLayout
            android:id="@+id/layout_time_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_start_time"
                style="@style/Widget.App.Input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="시작 시간"
                android:inputType="time" />

            <EditText
                android:id="@+id/input_end_time"
                style="@style/Widget.App.Input"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="종료 시간"
                android:inputType="time" />
        </LinearLayout>

        <!-- 일반 일정용 장소 입력 -->
        <EditText
            android:id="@+id/input_location"
            style="@style/Widget.App.Input"
            android:layout_marginTop="9dp"
            android:hint="장소" />

        <!-- 휴가 일정 전용 종료일 & 일수 계산 그룹 -->
        <LinearLayout
            android:id="@+id/layout_vacation_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/input_vacation_end"
                style="@style/Widget.App.Input"
                android:hint="휴가 종료 날짜 (YYYY-MM-DD)"
                android:inputType="date" />

            <TextView
                android:id="@+id/tv_vacation_days_calc"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/vacation_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="휴가 기간: 1일" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_schedule_memo"
            style="@style/Widget.App.Input.Multiline"
            android:layout_marginTop="9dp"
            android:hint="메모" />

        <TextView
            android:id="@+id/btn_save_schedule"
            style="@style/Widget.App.PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="일정 저장" />
    </LinearLayout>
</ScrollView>
