<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipToPadding="false"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Text.App.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="일정 추가" />

        <!-- 시작 날짜 & 종료 날짜 선택 그룹 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.App.CaptionBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시작 날짜" />

                <EditText
                    android:id="@+id/input_start_date"
                    style="@style/Widget.App.Input"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="2026-10-16" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.App.CaptionBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="종료 날짜" />

                <EditText
                    android:id="@+id/input_end_date"
                    style="@style/Widget.App.Input"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="2026-10-16" />
            </LinearLayout>
        </LinearLayout>

        <!-- 일정 유형 선택 스피너 -->
        <TextView
            style="@style/Text.App.CaptionBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="일정 유형" />

        <Spinner
            android:id="@+id/spinner_add_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/bg_input"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/input_schedule_title"
            style="@style/Widget.App.Input"
            android:hint="일정 제목" />

        <!-- 일반 일정용 시간 입력 그룹 -->
        <LinearLayout
            android:id="@+id/layout_time_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_start_time"
                style="@style/Widget.App.Input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="시작 시간 (19:00)" />

            <EditText
                android:id="@+id/input_end_time"
                style="@style/Widget.App.Input"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="종료 시간 (20:00)" />
        </LinearLayout>

        <!-- 일반 일정용 장소 입력 -->
        <EditText
            android:id="@+id/input_location"
            style="@style/Widget.App.Input"
            android:layout_marginTop="9dp"
            android:hint="장소" />

        <!-- 메모 -->
        <EditText
            android:id="@+id/input_schedule_memo"
            style="@style/Widget.App.Input.Multiline"
            android:layout_marginTop="9dp"
            android:hint="메모" />

        <TextView
            android:id="@+id/btn_save_schedule"
            style="@style/Widget.App.PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="일정 저장" />
    </LinearLayout>
</ScrollView>