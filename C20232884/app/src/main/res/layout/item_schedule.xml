<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/schedule_item"
        style="@style/Widget.App.ListRow"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/category_bar"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/forest_500" />

        <!-- 좌측: 날짜 & 요일/시간 (60dp) -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tv_start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="06.15" />

            <TextView
                android:id="@+id/tv_weekday_time"
                style="@style/Text.App.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                tools:text="월 14:00" />
        </LinearLayout>

        <!-- 우측: 제목 & 장소 (가변 영역) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_schedule_title"
                style="@style/Text.App.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textSize="14sp"
                tools:text="행정반 주간 업무 보고" />

            <TextView
                android:id="@+id/tv_location"
                style="@style/Text.App.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp"
                tools:text="본청 2층 회의실" />
        </LinearLayout>

        <!-- [올바른 위치] 우측 끝: 상세 정보 3점 버튼 (⋮) -->
        <TextView
            android:id="@+id/btn_item_more"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="상세 정보"
            android:focusable="true"
            android:gravity="center"
            android:text="≡"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>